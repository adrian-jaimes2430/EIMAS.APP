import type {StoryAct} from "@/types/story"; import {Button} from "@/components/ui/Button";
export function ActSection({act,active,refFn}:{act:StoryAct;active:boolean;refFn:(n:HTMLElement|null)=>void}){return <section ref={refFn} id={`act-${act.id}`} className={`story-act ${active?"is-active":""}`} aria-labelledby={`title-${act.id}`}><div className="act-content"><p className="eyebrow"><span>{act.number}</span>{act.kicker}</p><h2 id={`title-${act.id}`}>{act.title}</h2><p className="act-description">{act.description}</p>{act.id==="opportunity"&&<div className="signal-card"><div className="signal-top"><span>SIMULATED SIGNAL</span><small>EXAMPLE MARKET SIGNAL</small></div><strong>Emerging demand cluster</strong><div className="metrics"><span>Demand <b>94</b></span><span>Momentum <b>88</b></span><span>Competition <b>37</b></span></div></div>}{act.id==="magi"&&<div className="magi-panel"><div className="magi-top">MAGI / OBSERVATION MODE <span>READY</span></div>{["Analyzing market topology","Comparing signal relationships","Preparing validated hypotheses"].map((x,i)=><div className="magi-row" key={x}><small>0{i+1}</small>{x}</div>)}</div>}{act.cta&&<Button href={act.cta.href}>{act.cta.label}</Button>}</div><span className="act-number" aria-hidden="true">{act.number}</span></section>}
