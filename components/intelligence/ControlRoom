"use client"; import Link from "next/link"; import {useState} from "react"; import {STORY_ACTS} from "@/config/story"; import {IntelligenceScene} from "@/scenes/IntelligenceScene";
export function ControlRoom(){const [i,setI]=useState(0),[reduced,setReduced]=useState(false),[enabled,setEnabled]=useState(true),[density,setDensity]=useState(100);const a=STORY_ACTS[i];return <main className="control-room"><div className="control-scene"><IntelligenceScene state={a.sceneState} reduced={reduced} enabled={enabled} density={density}/></div><header className="control-header"><div><p className="eyebrow"><span>DEV</span>EIMAS CONTROL ROOM</p><h1>Scene inspector</h1></div><Link className="button button-ghost" href="/">Exit</Link></header><aside className="control-panel"><label>Act<select value={i} onChange={e=>setI(+e.target.value)}>{STORY_ACTS.map((x,n)=><option key={x.id} value={n}>{x.number} — {x.label}</option>)}</select></label><label className="toggle">Scene enabled<input type="checkbox" checked={enabled} onChange={e=>setEnabled(e.target.checked)}/></label><label className="toggle">Reduced motion<input type="checkbox" checked={reduced} onChange={e=>setReduced(e.target.checked)}/></label><label>Particle density<input type="range" min="25" max="100" value={density} onChange={e=>setDensity(+e.target.value)}/></label><div className="readout"><span>SCENE</span><b>{a.sceneState.toUpperCase()}</b><span>STATUS</span><b>{enabled?"READY":"FALLBACK"}</b><span>DENSITY</span><b>{density}%</b></div><p className="note">Particle density is applied to the procedural field. Additional GPU profiling is a later optimization task.</p></aside></main>}
